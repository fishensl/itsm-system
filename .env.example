# Core production settings
ITSM_ENV=production
ITSM_DATABASE_URI=postgresql://itsm:change-me@127.0.0.1:5432/itsm
ITSM_SECRET_KEY=replace-with-at-least-32-random-bytes

# Authentication hardening. All force switches are OFF unless explicitly enabled.
ITSM_FORCE_HTTPS=0
ITSM_MFA_ENFORCE=0
ITSM_CSP_ENABLED=0

# Optional master-key automation is intentionally not enabled by default.
# ITSM_AUTO_UNLOCK_KEY=
